<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AWSProjectType>Lambda</AWSProjectType>
    <!-- Gent reads this to determine the published 'files' artifact's version - required, not optional.
         Prerelease-shaped (contains '-') because this branch isn't 'main': PublishBranchPolicy requires
         the prerelease publish flag (and a prerelease-shaped version) for every branch except 'main'.
         Continues the existing 0.0.1-prerelease.N line already published to the Gitea registry. -->
    <Version>0.0.1-prerelease.2</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.Core" Version="3.3.0" />
    <PackageReference Include="Amazon.Lambda.Serialization.SystemTextJson" Version="3.0.1" />
  </ItemGroup>
</Project>
